; CombatUI.tscn
; Tactical combat overlay for Chronicles Unbound.
; Viewport: 1280x720 (stretch mode: canvas_items, aspect: expand)
; Layout summary:
;   VBoxContainer (root, full viewport)
;     PanelContainer (top bar — initiative order + round counter, ~50px)
;     HBoxContainer (main body — expands to fill remaining height)
;       Control (centre — transparent, lets combat grid show through)
;       PanelContainer (right panel — character info + actions, ~250px)
;     PanelContainer (bottom panel — combat log, ~120px)
;
; All interactive nodes use scene-unique names (%) for @onready resolution.

[gd_scene format=3 uid="uid://combat_ui"]

; ── External script reference ─────────────────────────────────────────────────
[ext_resource type="Script" path="res://Scripts/UI/CombatUI.gd" id="1_combatui"]
[ext_resource type="PackedScene" path="res://Scenes/Combat/CompanionActionPanel.tscn" id="2_companion_panel"]

; ── StyleBoxFlat resources ────────────────────────────────────────────────────
; Match NarrativeUI palette exactly — no new design tokens introduced.

