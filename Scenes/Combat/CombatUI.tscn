; ── Scene tree ────────────────────────────────────────────────────────────────

; Root — full-viewport Control with the GDScript controller attached.
; mouse_filter = IGNORE so the transparent centre area passes clicks to the grid.
[node name="CombatUI" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
script = ExtResource("1_combatui")

; ══════════════════════════════════════════════════════════════════════════════
; OUTER VERTICAL LAYOUT
; ══════════════════════════════════════════════════════════════════════════════

[node name="RootVBox" type="VBoxContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/separation = 0
mouse_filter = 2

; ══════════════════════════════════════════════════════════════════════════════
; TOP BAR — initiative order chips + round counter
; ══════════════════════════════════════════════════════════════════════════════

[node name="TopBar" type="PanelContainer" parent="RootVBox"]
layout_mode = 2
size_flags_horizontal = 3
custom_minimum_size = Vector2(0, 50)
theme_override_styles/panel = SubResource("StyleBox_topbar")

[node name="TopBarMargin" type="MarginContainer" parent="RootVBox/TopBar"]
layout_mode = 2
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
theme_override_constants/margin_left = 8
theme_override_constants/margin_top = 4
theme_override_constants/margin_right = 8
theme_override_constants/margin_bottom = 4

[node name="TopBarHBox" type="HBoxContainer" parent="RootVBox/TopBar/TopBarMargin"]
layout_mode = 2
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
theme_override_constants/separation = 4

; "INITIATIVE" label — left-anchored, aligns the bar with a section header
[node name="InitiativeHeaderLabel" type="Label" parent="RootVBox/TopBar/TopBarMargin/TopBarHBox"]
layout_mode = 2
size_flags_horizontal = 0
size_flags_vertical = 1
text = "INITIATIVE"
theme_override_colors/font_color = Color(0.788, 0.635, 0.153, 1.0)
theme_override_font_sizes/font_size = 10

; Scrollable row of initiative chips — grows to fill available width.
; Chips are created at runtime by CombatUI.gd via update_initiative_bar().
[node name="InitiativeScroll" type="ScrollContainer" parent="RootVBox/TopBar/TopBarMargin/TopBarHBox"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3
horizontal_scroll_mode = 1
vertical_scroll_mode = 0

[node name="InitiativeBar" type="HBoxContainer" parent="RootVBox/TopBar/TopBarMargin/TopBarHBox/InitiativeScroll"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 1
theme_override_constants/separation = 6

; Spacer between chip row and round counter
[node name="TopBarSpacer" type="Control" parent="RootVBox/TopBar/TopBarMargin/TopBarHBox"]
layout_mode = 2
custom_minimum_size = Vector2(12, 0)
size_flags_horizontal = 0

; Round counter — "Round: 1"
[node name="RoundLabel" type="Label" parent="RootVBox/TopBar/TopBarMargin/TopBarHBox"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 0
size_flags_vertical = 1
text = "Round: 1"
theme_override_colors/font_color = Color(0.933, 0.910, 0.835, 1.0)
theme_override_font_sizes/font_size = 13

; ══════════════════════════════════════════════════════════════════════════════
; MAIN BODY — transparent centre + right panel
; ══════════════════════════════════════════════════════════════════════════════

[node name="MainHBox" type="HBoxContainer" parent="RootVBox"]
layout_mode = 2
size_flags_vertical = 3
theme_override_constants/separation = 0
mouse_filter = 2

; Transparent pass-through — grid renders beneath this area
[node name="GridPassthrough" type="Control" parent="RootVBox/MainHBox"]
layout_mode = 2
size_flags_horizontal = 3
mouse_filter = 2

; ══════════════════════════════════════════════════════════════════════════════
; RIGHT PANEL — active character info + action buttons
; ══════════════════════════════════════════════════════════════════════════════

[node name="RightPanel" type="PanelContainer" parent="RootVBox/MainHBox"]
layout_mode = 2
custom_minimum_size = Vector2(250, 0)
size_flags_horizontal = 0
theme_override_styles/panel = SubResource("StyleBox_right_panel")

[node name="RightVBox" type="VBoxContainer" parent="RootVBox/MainHBox/RightPanel"]
layout_mode = 2
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
theme_override_constants/separation = 6

; ── Active character info card ─────────────────────────────────────────────────

[node name="CharInfoCard" type="PanelContainer" parent="RootVBox/MainHBox/RightPanel/RightVBox"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_styles/panel = SubResource("StyleBox_info_card")

[node name="CharInfoVBox" type="VBoxContainer" parent="RootVBox/MainHBox/RightPanel/RightVBox/CharInfoCard"]
