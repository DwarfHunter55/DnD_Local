; ══════════════════════════════════════════════════════════════════════════════
; MAIN CONTENT AREA — horizontal split: narrative (left) + party (right)
; ══════════════════════════════════════════════════════════════════════════════

[node name="MainHSplit" type="HSplitContainer" parent="RootVBox"]
layout_mode = 2
size_flags_vertical = 3
split_offset = 640
dragger_visibility = 2
theme_override_constants/separation = 0

; ══════════════════════════════════════════════════════════════════════════════
; LEFT PANEL — narrative display + action buttons + text input
; ══════════════════════════════════════════════════════════════════════════════

[node name="LeftPanel" type="PanelContainer" parent="RootVBox/MainHSplit"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_stretch_ratio = 0.70
theme_override_styles/panel = SubResource("StyleBox_bg_dark")

[node name="LeftVBox" type="VBoxContainer" parent="RootVBox/MainHSplit/LeftPanel"]
layout_mode = 2
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
theme_override_constants/separation = 8

; ── Narrative text area ────────────────────────────────────────────────────────

[node name="NarrativePanelMargin" type="MarginContainer" parent="RootVBox/MainHSplit/LeftPanel/LeftVBox"]
layout_mode = 2
size_flags_vertical = 3
theme_override_constants/margin_left = 8
theme_override_constants/margin_top = 8
theme_override_constants/margin_right = 8
theme_override_constants/margin_bottom = 0

[node name="NarrativePanel" type="PanelContainer" parent="RootVBox/MainHSplit/LeftPanel/LeftVBox/NarrativePanelMargin"]
layout_mode = 2
size_flags_vertical = 3
theme_override_styles/panel = SubResource("StyleBox_narrative_panel")

; RichTextLabel — the primary narrative display surface.
; scene_unique_name allows @onready to resolve via %NarrativeLabel.
[node name="NarrativeLabel" type="RichTextLabel" parent="RootVBox/MainHSplit/LeftPanel/LeftVBox/NarrativePanelMargin/NarrativePanel"]
unique_name_in_owner = true
layout_mode = 2
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
scroll_following = true
selection_enabled = true
bbcode_enabled = true
text = ""
theme_override_colors/default_color = Color(0.933, 0.910, 0.835, 1.0)
theme_override_colors/font_shadow_color = Color(0.0, 0.0, 0.0, 0.5)
theme_override_font_sizes/normal_font_size = 14
theme_override_font_sizes/bold_font_size = 14
theme_override_font_sizes/italics_font_size = 14

