corner_radius_top_right = 3
corner_radius_bottom_left = 3
corner_radius_bottom_right = 3

; HP bar fill — green default (overridden at runtime based on ratio)
[sub_resource type="StyleBoxFlat" id="StyleBox_hpbar_fill"]
