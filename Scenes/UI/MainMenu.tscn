[sub_resource type="StyleBoxFlat" id="StyleBox_btn_gold_normal"]
bg_color = Color(0.18, 0.14, 0.04, 1.0)
border_width_left = 2
border_width_top = 2
border_width_right = 2
border_width_bottom = 2
