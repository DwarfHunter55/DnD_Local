; ══════════════════════════════════════════════════════════════════════════════
; BOTTOM PANEL — combat log
; ══════════════════════════════════════════════════════════════════════════════

[node name="BottomPanel" type="PanelContainer" parent="RootVBox"]
layout_mode = 2
size_flags_horizontal = 3
custom_minimum_size = Vector2(0, 120)
theme_override_styles/panel = SubResource("StyleBox_bottom_panel")

[node name="BottomMargin" type="MarginContainer" parent="RootVBox/BottomPanel"]
layout_mode = 2
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
theme_override_constants/margin_left = 8
theme_override_constants/margin_top = 6
theme_override_constants/margin_right = 8
theme_override_constants/margin_bottom = 6

[node name="BottomHBox" type="HBoxContainer" parent="RootVBox/BottomPanel/BottomMargin"]
layout_mode = 2
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
theme_override_constants/separation = 8

; "COMBAT LOG" vertical header label — narrow, rotated via code is not reliable in Godot,
; so we use a compact upright label instead.
[node name="LogHeaderLabel" type="Label" parent="RootVBox/BottomPanel/BottomMargin/BottomHBox"]
layout_mode = 2
size_flags_horizontal = 0
size_flags_vertical = 1
text = "LOG"
theme_override_colors/font_color = Color(0.788, 0.635, 0.153, 1.0)
theme_override_font_sizes/font_size = 10

; Combat log display — BBCode-enabled, scroll-following, matches NarrativeLabel style
[node name="CombatLogPanel" type="PanelContainer" parent="RootVBox/BottomPanel/BottomMargin/BottomHBox"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3
theme_override_styles/panel = SubResource("StyleBox_log_panel")

[node name="CombatLog" type="RichTextLabel" parent="RootVBox/BottomPanel/BottomMargin/BottomHBox/CombatLogPanel"]
unique_name_in_owner = true
layout_mode = 2
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
scroll_following = true
selection_enabled = true
bbcode_enabled = true
text = ""
theme_override_colors/default_color = Color(0.933, 0.910, 0.835, 1.0)
theme_override_colors/font_shadow_color = Color(0.0, 0.0, 0.0, 0.5)
theme_override_font_sizes/normal_font_size = 13
theme_override_font_sizes/bold_font_size = 13
theme_override_font_sizes/italics_font_size = 13

; ══════════════════════════════════════════════════════════════════════════════
; COMPANION ACTION REVIEW PANEL — instanced from CompanionActionPanel.tscn.
; Floats over the grid area. Hidden by default; shown by CombatBridge when an
; AI companion's turn begins in Suggest autonomy mode.
; ══════════════════════════════════════════════════════════════════════════════

[node name="CompanionActionPanel" parent="." instance=ExtResource("2_companion_panel")]
unique_name_in_owner = true
