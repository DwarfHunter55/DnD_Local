; MainMenu.tscn
; Main menu scene for Chronicles Unbound.
; Full-viewport centered menu with dark fantasy styling.
; Emits signals that SceneManager connects to for navigation.

[gd_scene format=3 uid="uid://main_menu"]

; ── External script reference ─────────────────────────────────────────────────
[ext_resource type="Script" path="res://Scripts/UI/MainMenu.gd" id="1_mainmenu"]

; ── StyleBoxFlat resources ────────────────────────────────────────────────────

; Background — deep navy
[sub_resource type="StyleBoxFlat" id="StyleBox_background"]
bg_color = Color(0.063, 0.063, 0.157, 1.0)
border_width_left = 0
border_width_top = 0
border_width_right = 0
border_width_bottom = 0
corner_radius_top_left = 0
corner_radius_top_right = 0
corner_radius_bottom_left = 0
corner_radius_bottom_right = 0

; Standard button — normal state
[sub_resource type="StyleBoxFlat" id="StyleBox_btn_normal"]
bg_color = Color(0.11, 0.11, 0.20, 1.0)
border_width_left = 1
border_width_top = 1
border_width_right = 1
border_width_bottom = 1
border_color = Color(0.35, 0.30, 0.18, 0.7)
corner_radius_top_left = 4
corner_radius_top_right = 4
corner_radius_bottom_left = 4
corner_radius_bottom_right = 4
content_margin_left = 20.0
content_margin_top = 12.0
content_margin_right = 20.0
content_margin_bottom = 12.0

; Standard button — hover state
[sub_resource type="StyleBoxFlat" id="StyleBox_btn_hover"]
