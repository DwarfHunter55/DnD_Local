; LoadGame.tscn
; Load game save slot selection scene for Chronicles Unbound.
; Full-viewport scene with scrollable save slot list and dark fantasy styling.
; Emits signals that SceneManager connects to for navigation.

[gd_scene format=3 uid="uid://load_game"]

; ── External script reference ─────────────────────────────────────────────────
[ext_resource type="Script" path="res://Scripts/UI/LoadGame.gd" id="1_loadgame"]

