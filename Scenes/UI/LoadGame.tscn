; ── Scene tree ────────────────────────────────────────────────────────────────

; Root — full-viewport Control with the GDScript controller attached.
[node name="LoadGame" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_loadgame")

; Background panel covering the entire viewport
[node name="Background" type="Panel" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_styles/panel = SubResource("StyleBox_background")

; ══════════════════════════════════════════════════════════════════════════════
; MAIN CONTENT
; ══════════════════════════════════════════════════════════════════════════════

[node name="MarginContainer" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 60
theme_override_constants/margin_top = 40
theme_override_constants/margin_right = 60
theme_override_constants/margin_bottom = 40

[node name="VBoxContainer" type="VBoxContainer" parent="MarginContainer"]
layout_mode = 2
theme_override_constants/separation = 20

; ── Header ────────────────────────────────────────────────────────────────────

[node name="HeaderLabel" type="Label" parent="MarginContainer/VBoxContainer"]
layout_mode = 2
text = "Load Game"
theme_override_colors/font_color = Color(0.788, 0.635, 0.153, 1.0)
theme_override_colors/font_shadow_color = Color(0.0, 0.0, 0.0, 0.8)
theme_override_constants/shadow_offset_x = 2
theme_override_constants/shadow_offset_y = 2
theme_override_font_sizes/font_size = 36
horizontal_alignment = 1

; Spacer between header and content
[node name="HeaderSpacer" type="Control" parent="MarginContainer/VBoxContainer"]
layout_mode = 2
custom_minimum_size = Vector2(0, 20)

; ── Save slot list container ──────────────────────────────────────────────────

[node name="ScrollContainer" type="ScrollContainer" parent="MarginContainer/VBoxContainer"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 3
follow_focus = true
horizontal_scroll_mode = 0

[node name="SaveSlotList" type="VBoxContainer" parent="MarginContainer/VBoxContainer/ScrollContainer"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3
theme_override_constants/separation = 12

; ── Empty state label (visible when no saves exist) ──────────────────────────

[node name="EmptyStateLabel" type="Label" parent="MarginContainer/VBoxContainer/ScrollContainer/SaveSlotList"]
unique_name_in_owner = true
layout_mode = 2
text = "No saved games found"
theme_override_colors/font_color = Color(0.533, 0.533, 0.533, 1.0)
theme_override_font_sizes/font_size = 18
horizontal_alignment = 1
vertical_alignment = 1

; ── Bottom spacer and Back button ─────────────────────────────────────────────

[node name="BottomSpacer" type="Control" parent="MarginContainer/VBoxContainer"]
layout_mode = 2
custom_minimum_size = Vector2(0, 20)

[node name="BackButton" type="Button" parent="MarginContainer/VBoxContainer"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 4
custom_minimum_size = Vector2(200, 50)
text = "Back"
theme_override_colors/font_color = Color(0.933, 0.910, 0.835, 1.0)
theme_override_colors/font_hover_color = Color(0.788, 0.635, 0.153, 1.0)
theme_override_colors/font_pressed_color = Color(0.95, 0.82, 0.35, 1.0)
theme_override_styles/normal = SubResource("StyleBox_btn_normal")
theme_override_styles/hover = SubResource("StyleBox_btn_hover")
theme_override_styles/pressed = SubResource("StyleBox_btn_pressed")
theme_override_styles/focus = SubResource("StyleBox_btn_hover")
theme_override_font_sizes/font_size = 16
