; ExplorationUI.tscn
; Exploration screen for Chronicles Unbound.
; Viewport: 1280x720 (stretch mode: canvas_items, aspect: expand)
; Layout summary:
;   VBoxContainer (root, full viewport)
;     PanelContainer (top bar — location header + danger indicator, ~60px)
;     HBoxContainer (main body — expands to fill remaining height)
;       VBoxContainer (left — party panel, ~220px)
;       VBoxContainer (centre — narrative + actions, expands)
;       VBoxContainer (right — location list + connected locations, ~220px)
;
; All interactive nodes use scene-unique names (%) for @onready resolution.

[gd_scene format=3 uid="uid://exploration_ui"]

; ── External script reference ─────────────────────────────────────────────────
[ext_resource type="Script" path="res://Scripts/UI/ExplorationUI.gd" id="1_explorationui"]

; ── StyleBoxFlat resources ────────────────────────────────────────────────────
; Match NarrativeUI palette exactly.

; Root background — deep navy-charcoal
[sub_resource type="StyleBoxFlat" id="StyleBox_bg_dark"]
bg_color = Color(0.086, 0.086, 0.157, 1.0)
border_width_left = 0
border_width_top = 0
border_width_right = 0
border_width_bottom = 0
corner_radius_top_left = 0
corner_radius_top_right = 0
corner_radius_bottom_left = 0
corner_radius_bottom_right = 0

; Top bar — lighter charcoal with bottom gold border
[sub_resource type="StyleBoxFlat" id="StyleBox_topbar"]
bg_color = Color(0.102, 0.102, 0.18, 1.0)
border_width_left = 0
border_width_top = 0
border_width_right = 0
border_width_bottom = 2
border_color = Color(0.788, 0.635, 0.153, 1.0)
corner_radius_top_left = 0
corner_radius_top_right = 0
corner_radius_bottom_left = 0
corner_radius_bottom_right = 0

; Panel background — same as NarrativeUI party panel
[sub_resource type="StyleBoxFlat" id="StyleBox_panel"]
bg_color = Color(0.086, 0.086, 0.157, 1.0)
border_width_left = 1
border_width_top = 0
border_width_right = 0
border_width_bottom = 0
border_color = Color(0.35, 0.30, 0.18, 0.6)
corner_radius_top_left = 0
corner_radius_top_right = 0
corner_radius_bottom_left = 0
corner_radius_bottom_right = 0
content_margin_left = 8.0
content_margin_top = 8.0
content_margin_right = 8.0
content_margin_bottom = 8.0

; Narrative panel — darkest inset background
[sub_resource type="StyleBoxFlat" id="StyleBox_narrative_panel"]
bg_color = Color(0.063, 0.063, 0.118, 1.0)
border_width_left = 1
border_width_top = 1
border_width_right = 1
border_width_bottom = 1
border_color = Color(0.35, 0.30, 0.18, 0.6)
corner_radius_top_left = 4
corner_radius_top_right = 4
corner_radius_bottom_left = 4
corner_radius_bottom_right = 4
content_margin_left = 12.0
content_margin_top = 10.0
content_margin_right = 12.0
content_margin_bottom = 10.0

; Party slot card
