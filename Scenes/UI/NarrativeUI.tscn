; NarrativeUI.tscn
; Main narrative/exploration interface for Chronicles Unbound.
; Viewport: 1280x720 (stretch mode: canvas_items, aspect: expand)
; Layout summary:
;   VBoxContainer (root, full viewport)
;     PanelContainer (top bar, ~40px)
;     HSplitContainer (main area, expands)
;       PanelContainer (left — narrative + actions + input, ~70%)
;       PanelContainer (right — party panel, ~30%)
;     PanelContainer (bottom status bar, ~28px)
;
; All interactive nodes use scene-unique names (%) for @onready resolution.

[gd_scene format=3 uid="uid://narrative_ui"]

; ── External script reference ─────────────────────────────────────────────────
[ext_resource type="Script" path="res://Scripts/UI/NarrativeUI.gd" id="1_narrativeui"]

; ── StyleBoxFlat resources ────────────────────────────────────────────────────
; Defined once here and referenced by node theme_override_styles/panel.

; Root / top-bar / bottom-bar background — deep navy-charcoal
[sub_resource type="StyleBoxFlat" id="StyleBox_bg_dark"]
bg_color = Color(0.086, 0.086, 0.157, 1.0)
border_width_left = 0
border_width_top = 0
border_width_right = 0
border_width_bottom = 0
corner_radius_top_left = 0
corner_radius_top_right = 0
corner_radius_bottom_left = 0
corner_radius_bottom_right = 0

; Top bar accent — slightly lighter charcoal with bottom gold border
[sub_resource type="StyleBoxFlat" id="StyleBox_topbar"]
bg_color = Color(0.102, 0.102, 0.18, 1.0)
border_width_left = 0
border_width_top = 0
border_width_right = 0
border_width_bottom = 2
border_color = Color(0.788, 0.635, 0.153, 1.0)
corner_radius_top_left = 0
corner_radius_top_right = 0
corner_radius_bottom_left = 0
corner_radius_bottom_right = 0

; Narrative text area — darkest background
