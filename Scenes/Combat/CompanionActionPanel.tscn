; CompanionActionPanel.tscn
; Companion Action Review panel for Chronicles Unbound.
; Viewport: 1280x720 (stretch mode: canvas_items, aspect: expand)
;
; Layout summary — fixed-width panel anchored to the right side of its parent:
;   PanelContainer (root — 300px wide, anchored right, positioned by script for slide animation)
;     VBoxContainer (inner layout, separation=8)
;       HBoxContainer (header row — portrait + name)
;         ColorRect (portrait placeholder — 48x48, colored by companion hash)
;           Label (initial letter — centered over portrait)
;         Label (companion name — gold, 15px)
;       HSeparator
;       PanelContainer (action card — main suggestion display)
;         VBoxContainer
;           Label ("SUGGESTED ACTION" — section header, 10px gold)
;           Label (action display text — wrapping, 13px body)
;       PanelContainer (reasoning card)
;         VBoxContainer
;           Label ("REASONING" — 10px gold)
;           Label (reasoning text — wrapping, 12px dim)
;       HBoxContainer (three response buttons)
;         Button (Approve — green)
;         Button (Modify — gold)
;         Button (Override — red)
;       VBoxContainer (alternatives section — hidden until Modify pressed)
;         Label ("CHOOSE ALTERNATIVE" — 10px gold)
;         ScrollContainer (max height ~160px)
;           VBoxContainer (alternative buttons created at runtime)
;
; All interactive nodes use scene-unique names (%) for @onready resolution.

[gd_scene format=3 uid="uid://companion_action_panel"]

; ── External script reference ──────────────────────────────────────────────────
[ext_resource type="Script" path="res://Scripts/UI/CompanionActionPanel.gd" id="1_cap"]

