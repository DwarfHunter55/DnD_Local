; ── Fonts (system fallback — no custom font asset required) ───────────────────
; Font sizes are set via theme_override_font_sizes on individual nodes.

; ── Scene tree ────────────────────────────────────────────────────────────────

; Root — full-viewport Control with the GDScript controller attached.
[node name="NarrativeUI" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_styles/panel = SubResource("StyleBox_bg_dark")
script = ExtResource("1_narrativeui")

; ══════════════════════════════════════════════════════════════════════════════
; OUTER VERTICAL LAYOUT
; ══════════════════════════════════════════════════════════════════════════════

[node name="RootVBox" type="VBoxContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/separation = 0

; ══════════════════════════════════════════════════════════════════════════════
; TOP BAR
; ══════════════════════════════════════════════════════════════════════════════

[node name="TopBar" type="PanelContainer" parent="RootVBox"]
layout_mode = 2
size_flags_horizontal = 3
custom_minimum_size = Vector2(0, 40)
theme_override_styles/panel = SubResource("StyleBox_topbar")

[node name="TopBarHBox" type="HBoxContainer" parent="RootVBox/TopBar"]
layout_mode = 2
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
theme_override_constants/separation = 2

; Game title label — left-aligned in the top bar
[node name="TitleLabel" type="Label" parent="RootVBox/TopBar/TopBarHBox"]
layout_mode = 2
size_flags_horizontal = 0
text = "Chronicles Unbound"
theme_override_colors/font_color = Color(0.788, 0.635, 0.153, 1.0)
theme_override_font_sizes/font_size = 14

; Spacer pushes nav buttons to the right
[node name="TopBarSpacer" type="Control" parent="RootVBox/TopBar/TopBarHBox"]
layout_mode = 2
size_flags_horizontal = 3

